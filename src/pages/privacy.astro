---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy policy for Texas Movement Social. Full policy text is pending."
  path="/privacy"
>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Legal</span>
      <h1 class="hero__headline">Privacy Policy</h1>
      <div class="notice">
        <p>
          <strong>Policy content pending.</strong> Texas Movement Social has
          not yet published a finalized privacy policy for this property.
          This page is a placeholder so the route exists and is linked
          honestly from the footer — it does not represent real policy text.
          See <code>docs/LAUNCH_BLOCKERS.md</code> for status.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
