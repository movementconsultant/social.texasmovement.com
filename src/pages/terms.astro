---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms of Service"
  description="Terms of service for Texas Movement Social. Full terms text is pending."
  path="/terms"
>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Legal</span>
      <h1 class="hero__headline">Terms of Service</h1>
      <div class="notice">
        <p>
          <strong>Policy content pending.</strong> Texas Movement Social has
          not yet published finalized terms of service for this property.
          This page is a placeholder so the route exists and is linked
          honestly from the footer — it does not represent real legal text.
          See <code>docs/LAUNCH_BLOCKERS.md</code> for status.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
