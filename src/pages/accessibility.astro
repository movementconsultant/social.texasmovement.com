---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Accessibility"
  description="Accessibility statement for Texas Movement Social."
  path="/accessibility"
>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Legal</span>
      <h1 class="hero__headline">Accessibility</h1>
      <p class="blurb">
        This site targets WCAG 2.1 AA: a visible skip link, keyboard-reachable
        navigation, a single focus style applied consistently, one
        <code>&lt;h1&gt;</code> per page, and descriptive alt text on every
        meaningful image.
      </p>
      <div class="notice">
        <p>
          <strong>Formal accessibility statement pending.</strong> A full
          accessibility statement (conformance target, known issues, and a
          reporting route) has not been finalized for this property. This
          page is a placeholder so the route exists and is linked honestly
          from the footer. See <code>docs/LAUNCH_BLOCKERS.md</code> for
          status.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
